# Required for answer generation. Retrieval and evaluation work without them.
OPENAI_API_KEY=
OPENAI_MODEL=YOUR_MODEL_NAME

# Embedding model used by the dense retriever.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: USD per million tokens, used to estimate cost per query.
# Look up the current prices for your model; leave blank to report tokens only.
INPUT_PRICE_PER_1M_TOKENS=
OUTPUT_PRICE_PER_1M_TOKENS=
