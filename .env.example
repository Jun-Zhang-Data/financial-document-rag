# Application
APP_ENV=local
LOG_LEVEL=INFO
SERVICE_API_KEY=

# Retrieval: "memory" for local/dev or "postgres" for persistent production retrieval.
RETRIEVAL_BACKEND=memory
RAG_RETRIEVER=bm25
RAG_TOP_K=4
RAG_DEDUPE_PAGES=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# PostgreSQL / pgvector. Used when RETRIEVAL_BACKEND=postgres.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
POSTGRES_CANDIDATE_K=50
RRF_K=60

# LLM answer generation. Retrieval works without these.
# OPENAI_MODEL must be a real model id; an unset value fails fast rather than calling out.
OPENAI_API_KEY=
OPENAI_MODEL=
INPUT_PRICE_PER_1M_TOKENS=
OUTPUT_PRICE_PER_1M_TOKENS=

# Observability
METRICS_ENABLED=true
OTEL_SERVICE_NAME=financial-document-rag
# Example: http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
